# ── Flamenco2Techno AI - Variables de entorno ──────────────────────────────
# Copia este archivo como .env y ajusta los valores

# ── Aplicación ────────────────────────────────────────────────────────────
APP_NAME=Flamenco2Techno AI
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Base de datos PostgreSQL ──────────────────────────────────────────────
DB_USER=f2t_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=flamenco2techno
DATABASE_URL=postgresql+asyncpg://f2t_user:CHANGE_ME@postgres:5432/flamenco2techno

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Seguridad ─────────────────────────────────────────────────────────────
# IMPORTANTE: Cambiar en producción
API_KEY=CHANGE_ME_RANDOM_SECRET_KEY
ALLOWED_ORIGINS=["http://localhost:3000","https://tu-dominio.com"]

# ── Almacenamiento ────────────────────────────────────────────────────────
STORAGE_PATH=/app/storage
MAX_FILE_SIZE_MB=100
FILE_EXPIRY_HOURS=24

# ── Audio / IA ────────────────────────────────────────────────────────────
DEMUCS_MODEL=htdemucs
BPM_TARGET_MIN=125
BPM_TARGET_MAX=140
DEFAULT_TARGET_BPM=130
SAMPLE_RATE=44100
EXPORT_MP3_BITRATE=320k

# ── Celery ────────────────────────────────────────────────────────────────
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_TIME_LIMIT=600
